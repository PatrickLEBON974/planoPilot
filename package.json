{
  "name": "planopilot",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Planogrammes de vente pour Windows",
  "author": "PlanoPilot",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "dev:desktop": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "dist:win": "npm run build && node scripts/build-windows.cjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "fr.planopilot.desktop",
    "productName": "PlanoPilot",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "electron/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "plano",
        "name": "Projet PlanoPilot",
        "role": "Editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
